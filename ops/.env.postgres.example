# ═══════════════════════════════════════════════════════════════════════════
# LCYT PostgreSQL Development Environment Configuration
#
# Copy this file to .env and customize for your environment.
#
# Usage:
#   cp ops/.env.postgres.example .env
#   docker compose -f docker-compose.pg.yml up
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# PostgreSQL Configuration
# ───────────────────────────────────────────────────────────────────────────

# PostgreSQL credentials (change in production!)
POSTGRES_USER=lcyt_user
POSTGRES_PASSWORD=dev-password-change-me

# Database name
POSTGRES_DB=lcyt

# Connection URL (format: postgresql://user:password@host:port/database)
# Default uses direct PostgreSQL connection
# For connection pooling, use: postgresql://lcyt_user:dev-password-change-me@pgbouncer:6432/lcyt
DATABASE_URL=postgresql://lcyt_user:dev-password-change-me@postgres:5432/lcyt

# ───────────────────────────────────────────────────────────────────────────
# LCYT Backend Configuration
# ───────────────────────────────────────────────────────────────────────────

# Node environment
NODE_ENV=development
PORT=3000

# Server security (CHANGE THESE FOR PRODUCTION!)
JWT_SECRET=dev-jwt-secret-change-me-in-production
ADMIN_KEY=dev-admin-key-change-me-in-production

# Allowed domains for CORS and caption endpoints
ALLOWED_DOMAINS=localhost,127.0.0.1,app.lcyt.local,192.168.1.100

# Session configuration
SESSION_TTL=7200000           # 2 hours in milliseconds
CLEANUP_INTERVAL=300000        # 5 minutes in milliseconds

# ───────────────────────────────────────────────────────────────────────────
# Feature Flags (Phase 2 and beyond)
# ───────────────────────────────────────────────────────────────────────────

# Free API key generation (requires CAPTCHA setup)
FREE_APIKEY_ACTIVE=0

# RTMP relay plugin (requires ffmpeg + nginx-rtmp)
RTMP_RELAY_ACTIVE=0

# Graphics/DSK rendering plugin (requires Playwright + Chromium)
GRAPHICS_ENABLED=0

# ───────────────────────────────────────────────────────────────────────────
# Logging & Debug
# ───────────────────────────────────────────────────────────────────────────

# Prisma: 'query', 'info', 'warn', 'error', or empty to disable
PRISMA_LOG=info

# Uncomment to enable PostgreSQL query logging
# POSTGRES_LOG_STATEMENT=all

# ───────────────────────────────────────────────────────────────────────────
# pgAdmin Configuration (if running with --profile admin)
# ───────────────────────────────────────────────────────────────────────────

PGADMIN_EMAIL=admin@lcyt.local
PGADMIN_PASSWORD=admin-password-change-me

# ───────────────────────────────────────────────────────────────────────────
# PgBouncer Configuration (if running with --profile pooling)
# ───────────────────────────────────────────────────────────────────────────

# Max client connections (per pool)
PGBOUNCER_MAX_CLIENT_CONN=1000

# Default pool size per database
PGBOUNCER_DEFAULT_POOL_SIZE=25

# Reserve pool size for overflow
PGBOUNCER_RESERVE_POOL_SIZE=5

# Reserve pool timeout (seconds)
PGBOUNCER_RESERVE_POOL_TIMEOUT=3

# Pool mode: session, transaction, or statement
PGBOUNCER_POOL_MODE=transaction

# ───────────────────────────────────────────────────────────────────────────
# Health Check Configuration
# ───────────────────────────────────────────────────────────────────────────

# PostgreSQL health check timeout
POSTGRES_HEALTHCHECK_TIMEOUT=5

# Backend health check interval (seconds)
BACKEND_HEALTHCHECK_INTERVAL=30

# ───────────────────────────────────────────────────────────────────────────
# Testing Configuration (Phase 2: Database Matrix Testing)
# ───────────────────────────────────────────────────────────────────────────

# For dual-database testing, run tests twice:
#   1. With DATABASE_URL pointing to SQLite (default)
#   2. With DATABASE_URL pointing to PostgreSQL
#
# Example for manual testing:
#   npm test                                                    # SQLite
#   DATABASE_URL="postgresql://..." npm test                   # PostgreSQL

# Test database name (separate from development)
TEST_DATABASE_URL=postgresql://lcyt_user:dev-password-change-me@postgres:5432/lcyt_test
